{
    "label" : "lock",
    "action" : "swaylock -f -c 000000",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "swaymsg exit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend || loginctl suspend || zzz",
    "text" : "Suspend",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "poweroff",
    "text" : "Shutdown",
    "keybind" : "p"
}
